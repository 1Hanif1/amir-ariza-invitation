---
import { celebrationsIntro, events } from '../../data/wedding';
import type { ArtName } from '../../data/assets';
import Art from '../decorative/Art.astro';
import EventSection from './EventSection.astro';

// The Reception has no lily of its own: its pair stands in the garden below it.
const reception = events[events.length - 1];
const chapters: { lily?: ArtName; side: 'start' | 'end' }[] = [
  { lily: 'lily-haldi', side: 'start' },
  { lily: 'lily-nikah', side: 'end' },
  { side: 'start' },
];
---

<section id="celebrations" class="celebrations cusped-top" aria-labelledby="celebrations-title">
  <header class="celebrations__intro" data-reveal>
    <h2 id="celebrations-title" class="celebrations__title serif" data-write>The<br />Celebrations</h2>
    <p class="celebrations__lede">{celebrationsIntro}</p>
    <Art name="marigold-spray" class="celebrations__spray" />
  </header>

  {events.slice(0, -1).map((event, index) => <EventSection event={event} {...chapters[index]} />)}

  <!--
    The Reception and its garden share one dark page. On wide screens the garden's two lilies keep
    the guest company down the page: held small in the bottom corners of the screen, in the side
    margins, as the Reception scrolls past, then growing to full size as they land in the garden.
  -->
  <div class="reception">
    <EventSection event={reception} {...chapters[events.length - 1]} />
    <div class="reception-garden" aria-hidden="true"></div>
    <div class="reception-lilies" aria-hidden="true">
      <div class="reception-lilies__row">
        <Art name="lily-reception-left" class="reception-garden__lily" />
        <Art name="lily-reception-right" class="reception-garden__lily" />
      </div>
    </div>
  </div>
</section>

<style>
  .celebrations {
    --cusp-colour: var(--color-parchment);
    position: relative;
    z-index: 2;
    overflow-x: clip;
    background: var(--color-parchment);
  }

  .celebrations__intro {
    position: relative;
    max-width: 75rem;
    margin-inline: auto;
    padding: 3.5rem 1.25rem 2rem;
  }

  .celebrations__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 9vw, 6.25rem);
    font-weight: 400;
    line-height: 1;
  }

  .celebrations__lede {
    margin: 0.875rem 0 0;
    font-size: 1.25rem;
    color: var(--color-ink-soft);
  }

  .celebrations__spray {
    position: absolute;
    top: 1.5rem;
    right: -2.5rem;
    width: clamp(10.5rem, 42vw, 25rem);
    pointer-events: none;
  }

  /* One burgundy page for the Reception and its garden; the chapter's own background steps aside. */
  .reception {
    position: relative;
    container-type: inline-size;
    timeline-scope: --garden;
    background: var(--color-burgundy);
  }

  .reception :global(.chapter--rose) {
    position: relative;
    z-index: 1;
    background: transparent;
  }

  /* The ground the lilies rest on: as tall as they are (the artwork is 735 × 490). */
  .reception-garden {
    height: calc(min(50cqi, 38rem) * 490 / 735);
    view-timeline: --garden block;
  }

  /* The lilies' layer covers the whole Reception, behind its words; they rest at its foot. */
  .reception-lilies {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: clip;
    pointer-events: none;
  }

  .reception-lilies__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .reception-garden__lily {
    display: block;
    width: 50%;
    max-width: 38rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* The spray drifts against the scroll and turns a little as the guest passes it. */
      .celebrations__spray {
        animation: spray-drift linear both;
      }

      /* The timeline sits in its own rule, with a doubled class: in the same rule the minifier folds it into the animation shorthand, which browsers reject. */
      .celebrations__spray.celebrations__spray {
        animation-timeline: view();
      }

      /* The Reception's pair grows up from the bottom of the dark page as it comes into view. */
      .reception-garden__lily {
        animation: garden-rise linear both;
      }

      .reception-garden__lily.reception-garden__lily {
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }

      .reception-garden__lily.reception-garden__lily:last-child {
        animation-range: entry 10% cover 55%;
      }
    }
  }

  @keyframes spray-drift {
    from {
      translate: 0 2.5rem;
      rotate: -6deg;
    }
    to {
      translate: 0 -2.5rem;
      rotate: 5deg;
    }
  }

  @keyframes garden-rise {
    from {
      translate: 0 40%;
    }
    to {
      translate: 0 0;
    }
  }

  /*
   * Wide screens: the row of lilies is held at the foot of the screen (sticky) for as long as the
   * Reception is on screen, the lilies small in the side margins. Over the last stretch, as their
   * resting place scrolls into view, they grow into it. They never tilt: the artwork is cut flat
   * along its base, and a tilt would lift that edge into view.
   */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (timeline-scope: --garden) and (animation-timeline: view()) {
      .reception-lilies__row {
        position: sticky;
        bottom: 0;
      }

      .reception-garden__lily,
      .reception-garden__lily:last-child {
        animation: lily-land linear both;
      }

      .reception .reception-garden__lily.reception-garden__lily {
        animation-timeline: --garden;
        animation-range: entry 0% entry 100%;
      }

      .reception-garden__lily:first-child {
        transform-origin: 0 100%;
      }

      .reception-garden__lily:last-child {
        transform-origin: 100% 100%;
      }
    }
  }

  @keyframes lily-land {
    from {
      scale: 0.5;
    }
    to {
      scale: 1;
    }
  }

  @media (min-width: 48rem) {
    .celebrations__intro {
      padding: 6rem 2.5rem 4rem;
    }

    .celebrations__spray {
      top: 3rem;
      right: 2rem;
    }
  }
</style>
