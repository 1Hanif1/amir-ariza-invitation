---
import { bismillah, couple, events } from '../../data/wedding';
import Art from '../decorative/Art.astro';
---

<section id="home" class="hero" aria-labelledby="hero-names">
  <div class="hero__page">
    <div class="hero__sacred rise">
      <Art name="bismillah" class="hero__tughra" eager />
      <p class="hero__transliteration serif">{bismillah.transliteration}</p>
    </div>

    <p class="hero__headline rise" style="--delay: 250ms">{couple.headline}</p>

    <h1 id="hero-names" class="hero__names script">
      <span class="hero__name hero__name--groom" data-write style="--write-delay: 400ms">{couple.groom.full}</span>
      <span class="hero__ampersand rise" style="--delay: 850ms">&amp;</span>
      <span class="hero__name hero__name--bride" data-write style="--write-delay: 1000ms">{couple.bride.full}</span>
    </h1>

    <p class="hero__date serif rise" style="--delay: 1500ms">
      <time datetime={couple.date.iso}>
        <span class="hero__date-side">{couple.date.weekday}</span>
        <span class="hero__date-day">{couple.date.day}</span>
        <span class="hero__date-side">{couple.date.month} {couple.date.year}</span>
      </time>
    </p>

    <div class="hero__monogram rise" style="--delay: 1750ms">
      <Art name="aa-monogram" class="hero__monogram-art" eager />
    </div>
  </div>

  <div class="hero__garden">
    <div class="hero__ground">
      <Art name="hero-lily-left" class="hero__lily hero__lily--left bloom" eager />
      <Art name="hero-lily-right" class="hero__lily hero__lily--right bloom" eager />
    </div>
  </div>

  <nav class="hero__dates jadval" aria-label="Jump to an event">
    <ul>
      {
        events.map((event) => (
          <li>
            <a href={`#${event.id}`}>
              <span class="hero__jump-date serif">
                {event.day} {event.shortMonth}
              </span>
              <span class="hero__jump-name">
                <span class="hero__jump-event">{event.shortName}</span>
                <span>{event.city}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .hero__page {
    position: relative;
    z-index: 3;
    width: var(--arch-width);
    margin-inline: auto;
    /* Clears the point of the arch; the crown scales with its width. */
    padding: calc(var(--arch-width) * 0.12) 1.75rem 0;
    /* The names are sized against this width, so they always keep clear of the arch. */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__sacred {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__tughra {
    width: clamp(7.5rem, 24vw, 13.5rem);
  }

  .hero__transliteration {
    margin: 0.5rem 0 0;
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    font-style: italic;
    color: var(--color-ink);
  }

  .hero__headline {
    margin: clamp(1.75rem, 4.5vh, 3rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .hero__names {
    width: 100%;
    margin: clamp(1.25rem, 3vh, 2.25rem) 0 0;
    font-size: min(15cqi, 4rem);
    line-height: 1.12;
    display: flex;
    flex-direction: column;
    color: var(--color-ink);
  }

  .hero__name {
    display: block;
    text-wrap: balance;
  }

  .hero__name--groom {
    text-align: left;
  }

  .hero__name--bride {
    text-align: right;
    color: var(--color-burgundy);
  }

  /* Cormorant's italic ampersand, between the two scripted names. */
  .hero__ampersand {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.62em;
    line-height: 1.2;
    color: var(--color-saffron-ink);
  }

  .hero__date {
    margin: clamp(1.5rem, 4vh, 2.75rem) 0 0;
    color: var(--color-ink);
  }

  .hero__date time {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.125rem, 2.4vw, 1.625rem);
    font-weight: 600;
  }

  .hero__date-day {
    padding-inline: 0.75rem;
    font-size: 1.75em;
    line-height: 1;
    border-inline: 1px solid var(--color-burgundy);
  }

  /* Takes up whatever height the page leaves, so the lilies always rest on the date band. */
  .hero__garden {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 44vw;
    /* Trims the lilies along the ground line. They stay free to rise upward and bleed sideways. */
    clip-path: inset(-100vh -100vw 0 -100vw);
  }

  /* Holds the lilies, so they can sink back into the ground as the guest scrolls away. */
  .hero__ground {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero__ground {
        animation: lilies-settle linear both;
      }

      /* The timeline sits in its own rule, with a doubled class: in the same rule the minifier folds it into the animation shorthand, which browsers reject. */
      .hero__ground.hero__ground {
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes lilies-settle {
    to {
      translate: 0 30%;
    }
  }

  /* Set slightly past the edges, so the slow sway never reveals where the artwork is cropped. */
  .hero__lily {
    position: absolute;
    bottom: -0.75rem;
    height: auto;
    max-width: none;
  }

  .hero__lily--left {
    left: -0.5rem;
    width: 66vw;
    transform-origin: 0 100%;
  }

  /* The smaller lily keeps the composition from reading as a symmetrical card. */
  .hero__lily--right {
    right: -0.5rem;
    width: 44vw;
    transform-origin: 100% 100%;
  }

  .hero__monogram {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    width: clamp(4.5rem, 19vw, 5.5rem);
  }

  .hero__monogram-art {
    display: block;
    width: 100%;
  }

  /* Fills the arch between its inner rulings, so the legs run on unbroken either side. */
  .hero__dates {
    position: relative;
    z-index: 4;
    align-self: center;
    width: calc(var(--arch-width) * 0.934);
    background: var(--color-parchment);
    padding-block: 0.625rem 0;
    border-bottom: 1px solid var(--color-burgundy);
  }

  /* The same ruling carries on outside the arch, as the ground the lilies grow from. */
  .hero__dates::before,
  .hero__dates::after {
    content: '';
    position: absolute;
    top: -1px;
    width: 100vw;
    height: 0.5625rem;
    border-top: 1px solid var(--color-teal);
    border-bottom: 1px solid var(--color-burgundy);
    background: linear-gradient(var(--color-saffron), var(--color-saffron)) 0 2px / 100% 2px no-repeat;
  }

  /* 0.031 of the arch is the gap from this panel's edge to the arch's outermost ruling. */
  .hero__dates::before {
    right: calc(100% + var(--arch-width) * 0.031);
  }

  .hero__dates::after {
    left: calc(100% + var(--arch-width) * 0.031);
  }

  .hero__dates ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__dates li + li {
    border-inline-start: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .hero__dates a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 4.25rem;
    padding: 0.5rem 0.25rem;
    text-align: center;
    text-decoration: none;
    transition: background-color 250ms ease;
  }

  .hero__dates a:hover {
    background: var(--color-ivory);
  }

  .hero__jump-date {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-burgundy);
  }

  /* Event and city stack on phones, so all three columns wrap the same way. */
  .hero__jump-name {
    display: flex;
    flex-direction: column;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--color-ink);
  }

  @media (max-width: 22.5rem) {
    .hero__date time {
      gap: 0.5rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 48rem) {
    .hero__page {
      padding-inline: clamp(4.5rem, calc(var(--arch-width) * 0.12), 8rem);
    }

    /*
     * Names stay on one line and step across the arch, his from the left, hers from the right,
     * sized to the room inside the arch so there is always clear space either side.
     */
    .hero__names {
      font-size: min(9.6cqi, 11vh, 6rem);
    }

    .hero__name {
      white-space: nowrap;
    }

    .hero__ampersand {
      margin-block: -0.05em;
    }

    .hero__garden {
      min-height: 32vw;
    }

    .hero__lily--left {
      width: 46vw;
    }

    .hero__lily--right {
      width: 32vw;
    }

    .hero__tughra {
      width: clamp(8rem, 18vh, 13.5rem);
    }

    .hero__monogram {
      width: clamp(4rem, 10vh, 6rem);
    }

    .hero__jump-date {
      font-size: 1.625rem;
    }

    .hero__jump-name {
      flex-direction: row;
      gap: 0.25em;
      font-size: 1.0625rem;
    }

    .hero__jump-event::after {
      content: ',';
    }
  }

  /* With room beside the arch, the lilies climb it next to the date and the hero fits one screen. */
  @media (min-width: 75rem) {
    .hero__garden {
      flex: 0 0 auto;
      height: 0;
      min-height: 0;
      pointer-events: none;
    }

    .hero__page {
      flex: 1;
      padding-bottom: 1.25rem;
    }

    .hero__lily--left {
      width: clamp(19rem, 40vh, 28rem);
    }

    .hero__lily--right {
      width: clamp(14rem, 30vh, 21rem);
    }
  }
</style>
