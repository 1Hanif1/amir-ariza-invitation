---
/**
 * A link set like printed stationery: a slim rectangle with a double rule, a thin line in the
 * accent colour outside a fine saffron one. On hover, focus or tap it fills with the accent from
 * the bottom up and the lettering turns to --on-accent.
 *
 * Colours come from the parent: --accent (rule and fill) and --on-accent (lettering once filled).
 */
interface Props {
  href: string;
  /** Visible label. */
  label: string;
  /** Extra words for screen readers only, read after the label. */
  srLabel?: string;
  /** Opens in a new tab (say so to screen readers through srLabel). */
  external?: boolean;
  /** Shows the map-pin glyph before the label. */
  pin?: boolean;
}

const { href, label, srLabel, external = false, pin = false } = Astro.props;
---

<a class="ruled" href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  {
    pin && (
      <svg class="ruled__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 21.5s-6.75-5.9-6.75-11.6a6.75 6.75 0 0 1 13.5 0C18.75 15.6 12 21.5 12 21.5Z" />
        <circle cx="12" cy="9.9" r="2.35" />
      </svg>
    )
  }
  <span>{label}</span>
  {srLabel && <span class="sr-only">{srLabel}</span>}
</a>

<style>
  .ruled {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 350ms ease 80ms;
  }

  /* The inner saffron rule. */
  .ruled::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid var(--color-saffron);
    pointer-events: none;
    transition: border-color 350ms ease;
  }

  /* The fill, rising from the bottom. */
  .ruled::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform-origin: 50% 100%;
    scale: 1 0;
    transition: scale 450ms cubic-bezier(0.6, 0, 0.2, 1);
  }

  .ruled:hover,
  .ruled:focus-visible,
  .ruled:active {
    color: var(--on-accent, var(--color-ivory));
  }

  .ruled:hover::after,
  .ruled:focus-visible::after,
  .ruled:active::after {
    scale: 1 1;
  }

  /* Once filled, the inner rule turns to the lettering colour so it still reads. */
  .ruled:hover::before,
  .ruled:focus-visible::before,
  .ruled:active::before {
    border-color: color-mix(in srgb, var(--on-accent, var(--color-ivory)) 55%, transparent);
  }

  .ruled:focus-visible {
    outline-offset: 4px;
  }

  .ruled__pin {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: -0.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .ruled,
    .ruled::before,
    .ruled::after {
      transition: none;
    }
  }
</style>
